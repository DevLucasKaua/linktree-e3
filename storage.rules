rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Fotos dos clientes: leitura pública (usada no preview e no export),
    // escrita apenas por gestores da allowlist.
    match /linktrees/{id}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/managers/$(request.auth.token.email));
    }
  }
}
